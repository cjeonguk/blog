---
import BaseLayout from "../layouts/BaseLayout.astro";

// The index in /pagefind/ is created by `pagefind` after `astro build`.
// Search therefore works in `pnpm build && pnpm preview`, not in `pnpm dev`.
---

<BaseLayout title="Search" description="Search posts.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  </Fragment>

  <article class="post">
    <header class="post-header">
      <h1 class="post-title">Search</h1>
    </header>

    <div class="search">
      <pagefind-config excerpt-length="24"></pagefind-config>
      <pagefind-input placeholder="Search posts" autofocus></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <pagefind-results></pagefind-results>
    </div>
    <noscript><p>Search needs JavaScript.</p></noscript>
  </article>
</BaseLayout>

<style is:global>
  .search {
    --pf-font: inherit;
    --pf-text: var(--text-color);
    --pf-text-secondary: var(--grey-color);
    --pf-text-muted: var(--grey-color);
    --pf-background: var(--background-color);
    --pf-border: var(--grey-color-light);
    --pf-border-focus: var(--grey-color);
    --pf-hover: var(--code-background);
    --pf-skeleton: var(--grey-color-light);
    --pf-skeleton-shine: var(--background-color);
    --pf-mark: var(--text-color);
    --pf-outline-focus: var(--brand-color);
    --pf-border-radius: 3px;
    --pf-summary-font-size: 14px;
    --pf-result-title-font-size: 18px;
    --pf-result-excerpt-font-size: 15px;

    display: flex;
    flex-direction: column;
    gap: 15px;
  }
</style>
