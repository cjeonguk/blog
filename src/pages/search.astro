---
import BaseLayout from "../layouts/BaseLayout.astro";

// The index in /pagefind/ is created by `pagefind` after `astro build`.
// Search therefore works in `pnpm build && pnpm preview`, not in `pnpm dev`.
---

<BaseLayout title="Search" description="Search posts.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  </Fragment>

  <article class="post">
    <header class="post-header">
      <h1 class="post-title">Search</h1>
    </header>

    <div class="search">
      <pagefind-config excerpt-length="24"></pagefind-config>
      <pagefind-input placeholder="Search posts" autofocus></pagefind-input>
      <pagefind-summary></pagefind-summary>
      <ul class="post-list search-results" aria-label="Search results"></ul>
    </div>
    <noscript><p>Search needs JavaScript.</p></noscript>
  </article>
</BaseLayout>

<script is:inline type="module">
  // Pagefind's input and summary components drive the search. Results are
  // drawn here with the same markup as the home page post list.
  await customElements.whenDefined("pagefind-input");
  const instance = window.PagefindComponents.getInstanceManager().getInstance("default");
  const list = document.querySelector(".search-results");

  const formatDate = (iso) =>
    new Date(iso).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    });

  const el = (tag, attrs = {}, children = []) => {
    const node = document.createElement(tag);
    for (const [key, value] of Object.entries(attrs)) {
      if (key === "html") node.innerHTML = value;
      else if (key === "text") node.textContent = value;
      else node.setAttribute(key, value);
    }
    node.append(...children);
    return node;
  };

  const renderResult = (data) => {
    const subResults = instance.getDisplaySubResults(data, 3);
    return el("li", {}, [
      data.meta.date ? el("span", { class: "post-meta", text: formatDate(data.meta.date) }) : "",
      el("h3", {}, [el("a", { class: "post-link", href: data.url, text: data.meta.title })]),
      el("p", { html: data.excerpt }),
      subResults.length
        ? el(
            "ul",
            { class: "search-sub-results" },
            subResults.map((sub) =>
              el("li", {}, [
                el("a", { href: sub.url, text: sub.title }),
                el("p", { class: "post-meta", html: sub.excerpt }),
              ]),
            ),
          )
        : "",
    ]);
  };

  // Ignore results from an older query that finish loading late.
  let latest = 0;
  instance.on("results", async (searchResult) => {
    const run = ++latest;
    const items = await Promise.all(searchResult.results.map((r) => r.data()));
    if (run !== latest) return;
    list.replaceChildren(...items.map(renderResult));
  });
</script>
