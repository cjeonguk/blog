---
import { SITE } from "../config";
import "../styles/main.scss";

interface Props {
  title?: string;
  description?: string;
  article?: { published: Date };
}

const { title, description = SITE.description, article } = Astro.props;

// Matches jekyll-seo-tag: "Site | Tagline" on the home page, "Page | Site" elsewhere.
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: article.published.toISOString(),
      author: { "@type": "Person", name: SITE.author.name },
      url: canonical.href,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      description: SITE.description,
      author: { "@type": "Person", name: SITE.author.name },
      url: canonical.href,
    };
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author.name} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title ?? SITE.title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={article ? "article" : "website"} />
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  <meta name="twitter:card" content="summary" />
  <meta property="twitter:title" content={title ?? SITE.title} />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <slot />
</head>
