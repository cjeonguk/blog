---
import { SITE } from "../config";
import { getSocialLinks } from "../lib/social";
import "../styles/main.scss";

interface Props {
  title?: string;
  description?: string;
  /** Link preview image path. Falls back to SITE.image. */
  image?: string;
  article?: { published: Date; modified?: Date };
}

const { title, description = SITE.description, image = SITE.image, article } = Astro.props;

// Matches jekyll-seo-tag: "Site | Tagline" on the home page, "Page | Site" elsewhere.
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = image && new URL(image, Astro.site).href;
const twitter = SITE.social.twitter;

const author = {
  "@type": "Person",
  name: SITE.author.name,
  sameAs: getSocialLinks().map((link) => link.url),
};

const jsonLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      author,
      image: imageUrl,
      url: canonical.href,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
      publisher: SITE.logo && {
        "@type": "Organization",
        name: SITE.author.name,
        logo: { "@type": "ImageObject", url: new URL(SITE.logo, Astro.site).href },
      },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      description: SITE.description,
      author,
      image: imageUrl,
      url: canonical.href,
    };
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <meta name="author" content={SITE.author.name} />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title ?? SITE.title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:type" content={article ? "article" : "website"} />
  {imageUrl && <meta property="og:image" content={imageUrl} />}
  {article && <meta property="article:published_time" content={article.published.toISOString()} />}
  {article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
  <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
  <meta property="twitter:title" content={title ?? SITE.title} />
  {imageUrl && <meta property="twitter:image" content={imageUrl} />}
  {twitter && <meta name="twitter:site" content={`@${twitter}`} />}

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <slot />
</head>
